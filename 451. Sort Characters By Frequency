class Solution {
public:
    string frequencySort(string s) {
        vector<int> freq(256,0);

        for(char ch:s){
            freq[ch]++;
        }

        vector<vector<char>> buckets(s.size() + 1);
        for(int i =0 ;i<256; i++){
            if(freq[i]>0){
                buckets[freq[i]].push_back((char)i);
            }
        }

        string result= "";
        for(int i=s.size(); i>0; i--) {
            for(char ch : buckets[i]) {
                result.append(i, ch);
            }
        }

        return result;

    }
};
